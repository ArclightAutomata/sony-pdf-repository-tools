# Copy to .env and fill in what you need. Real environment variables take precedence.
# The dump's UNSORTED folder (for `sonyarc.py ingest`)
SONY_PDF_SOURCE=/path/to/sony-pdfs/UNSORTED
# TypeSafe AI key for Jev (classify.py, jev_eval/run_eval.py)
JEV_API_KEY=
# Optional: a salli-cat manuals.db (https://github.com/ArclightAutomata/salli-cat), so label.py can flag documents you already have
# SALLI_DB=/path/to/manuals.db
